# Копия переменных окружения для Yandex Serverless Container.
# НЕ коммитьте реальные секреты! Скопируйте в .env или настройте в YC.

# S3 / Yandex Object Storage
YC_S3_ENDPOINT=https://storage.yandexcloud.net
BUCKET_NAME=your-bucket-name
YC_ACCESS_KEY_ID=your-static-key-id
YC_SECRET_ACCESS_KEY=your-static-secret

# Папка готовых роликов в бакете (вариант A).
# В Yandex Object Storage бакета файлы лежат по пути: video/Kaskad_Video/
# Внутри лежат файлы: Каскад_Парк.mp4, Академия_Парк.mp4,
# Федоскино Парк Общее видео.mp4, Парк_Апрель.mp4.
# Если S3-креденшелы не заданы — бэкенд автоматически отдаёт ролики
# из backend/media (локальный режим для проверки в Streamlit).
VIDEO_S3_ROOT=video/Kaskad_Video

# Опциональные пути к моделям (если отличаются от дефолтных)
MODEL_PATH=/app/model/global_best_model.joblib
EXPLAINER_PATH=/app/model/xgb_explainer.joblib
FEATURE_NAMES_PATH=/app/data/feature_names.txt

# Настройки сборки ролика
MAX_SHAP_FACTORS=4
# true  -> самый важный SHAP-фактор выводится последним (финал)
# false -> топ-факторы идут сразу после общего вида по убыванию
INVERT_SHAP_ORDER=false

# --- Автоматическое резервное копирование метрик в S3 ---
# Папка метрик в бакете. Если заданы S3-кредакторы (выше), то:
#   - при старте контейнер скачает накопленный metrics.csv (метрики не обнулятся)
#   - после каждого инференса CSV загружается обратно в {PREFIX}metrics.csv
# Если переменные S3 не заданы — метрики просто живут локально.
METRICS_S3_PREFIX=metrics/
